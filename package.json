{
  "name": "lostbox",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @lostbox/web dev",
    "seed:demo": "pnpm --filter @lostbox/web seed:demo",
    "build": "pnpm --filter @lostbox/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:supabase": "pnpm --filter @lostbox/web test:supabase",
    "db:status": "supabase migration list --linked",
    "db:push": "supabase db push --linked",
    "db:push:dry": "supabase db push --linked --dry-run",
    "smoke": "pnpm --filter @lostbox/web smoke",
    "test:e2e": "pnpm --filter @lostbox/web test:e2e",
    "eval": "pnpm --filter @lostbox/eval eval"
  },
  "devDependencies": {
    "supabase": "^2.118.0"
  }
}
